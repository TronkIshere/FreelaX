# Local development template only. Keep real Solana keys and signer material in untracked runtime configuration.
MYSQL_ROOT_PASSWORD=

PAYMENT_INTERNAL_API_KEY=
SOLANA_INTERNAL_API_KEY=

MISA_PLATFORM_ACCOUNT_EMAIL=platform@marketplace.local
MISA_PLATFORM_ACCOUNT_PASSWORD=
MISA_CERTIFICATE_AUTO_ISSUE=true
MISA_CERTIFICATE_AUTO_SUBMIT=true

SOLANA_RPC_HTTP_URL=http://host.docker.internal:9123
SOLANA_PROGRAM_ID=2Tx2faZU1siV1xvKMxbRN1VesgXftjM3Lff3Nwn69oqb
SOLANA_NETWORK=localnet
SOLANA_COMMITMENT=confirmed

# Blank Solana values must be provided at local runtime; never commit real values.
SOLANA_CUSTODIAL_CLIENT_PUBLIC_KEY=
DEMO_FREELANCER_SOLANA_PUBLIC_KEY=
SOLANA_ONRAMP_AUTHORITY_PUBLIC_KEY=
SOLANA_SYSTEM_FEE_PAYER=
SOLANA_LOCAL_PRIVATE_KEYS=

# Supply distinct, random runtime secrets (24+ characters) in ignored .env.
# The seed passwords rotate existing demo accounts and revoke their refresh sessions on startup.
# Demo account passwords (client, freelancer, admin, payment demo user): 24 to 72 characters (bcrypt rejects more than 72 bytes and the
# service then fails to start).
DEMO_CLIENT_PASSWORD=
DEMO_FREELANCER_PASSWORD=
# Optional local E2E Admin fixture; only accepted by Marketplace in the dev profile.
DEMO_ADMIN_PASSWORD=
# Optional local E2E shortcut for Admin dispute tests; keep 0 for normal business timing.
PARTNER_MOCK_E2E_NEGOTIATION_SECONDS=0
# true: Jobs created from now on use UNIFIED_USDC_PAYOUT only; existing Jobs keep their rail.
# Recreate only marketplace-backend after changing it. See docs/business/CUTOVER_RUNBOOK.md.
# Marketplace schema is managed by Flyway (db/migration); Hibernate only validates it.
PAYMENT_FLOW_CUTOVER_ENABLED=false
PAYMENT_DEMO_USER_PASSWORD=
# JWT signing secrets (payment, MISA and marketplace): at least 64 characters (HS512). A shorter value starts the service but makes
# sign-in fail with HTTP 500. Generate one with: openssl rand -hex 48
PAYMENT_JWT_SECRET=
MISA_JWT_SECRET=
PAYMENT_SPRING_PROFILE=dev
MISA_SPRING_PROFILE=dev

# Marketplace must keep the same signing secret on every recreation.
# Set the real value only in ignored .env.
MARKETPLACE_JWT_SECRET=
MARKETPLACE_SPRING_PROFILE=dev
MARKETPLACE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local demo binds all frontend host ports to loopback.
FREELAX_SITE_ADDRESS=:80
FREELAX_HTTP_BIND=127.0.0.1:8080
FREELAX_HTTPS_BIND=127.0.0.1:8443

# Leave blank so the local browser uses same-origin /api/v1.
# Never put secrets or internal service URLs in VITE_ variables.
VITE_MARKETPLACE_API_ORIGIN=
VITE_SOLANA_CLUSTER=localnet
# Shows the Avalanche escrow panel (development simulation) in the browser build; the backend rail has its own switch (AVALANCHE_GATEWAY_ENABLED).
VITE_AVALANCHE_ENABLED=false

# Local/demo only. Separate AES key for stored demo wallet keys; unset keeps the legacy JWT-derived key.
# Startup fails if this or SOLANA_LOCAL_PRIVATE_KEYS is set outside the dev profile on localnet.
LOCAL_WALLET_ENCRYPTION_KEY=
# Dev default true. Non-dev profiles reject a failed live rate instead of using the 25000 fallback.
EXCHANGE_RATE_ALLOW_FALLBACK=true

# Avalanche development simulation (opt-in compose profile "avalanche"). Placeholders only; no secrets.
# AVALANCHE_ENVIRONMENT has no default and must be LOCAL_SIMULATION or AVALANCHE_FUJI. Mainnet is not supported.
# LOCAL_SIMULATION example RPC: http://host.docker.internal:8545 (local Anvil). AVALANCHE_FUJI: an allow-listed public Fuji https host.
AVALANCHE_ENVIRONMENT=
AVALANCHE_RPC_PRIMARY_URL=
AVALANCHE_RPC_SECONDARY_URL=
# Minimum gap between RPC calls (default 1000 ms protects a public endpoint; 0 is fine for a local Anvil) and the RPC timeout.
AVALANCHE_RPC_MIN_GAP_MS=1000
AVALANCHE_RPC_TIMEOUT_MS=10000

# Avalanche gateway opt-in features (both default to false). Development signers exist only in LOCAL_SIMULATION.
# Transaction tracking needs a separately provisioned LOCAL MySQL database named avalanche_gateway; the service refuses any
# other host or database name. Placeholders only: never commit real credentials.
AVALANCHE_SIGNERS_ENABLED=false
AVALANCHE_TX_ENABLED=false
AVALANCHE_DB_URL=
AVALANCHE_DB_USERNAME=
AVALANCHE_DB_PASSWORD=
# Periodic reconciliation of gateway-submitted transactions (milliseconds; 0 disables it). Without it, a transaction the gateway
# submitted (LOCAL_SIMULATION "execute") is never advanced past SUBMITTED (no other runtime caller), so set e.g. 2000 when tracking.
AVALANCHE_TX_RECONCILE_INTERVAL_MS=0

# Log scanning (opt-in, needs AVALANCHE_TX_ENABLED=true). WS URL is optional and used only as a latency hint.
AVALANCHE_SCAN_ENABLED=false
AVALANCHE_SCAN_CONTRACT_ADDRESS=
AVALANCHE_SCAN_WS_URL=
# Periodic scan pass (milliseconds; 0 disables the timer, so without a WS hint URL no scan runs). Example: 5000.
AVALANCHE_SCAN_INTERVAL_MS=0

# Deployment manifest produced by avalanche-contracts/script/Deploy.s.sol (addresses only). Inside the container the folder is mounted at /deployments.
# Required to submit transactions: only the manifest escrow and token may be called.
AVALANCHE_DEPLOYMENT_MANIFEST=

# Shared secret the marketplace sends as X-Internal-Api-Key to the Avalanche gateway. Blank refuses every POST. Never commit a real value.
AVALANCHE_INTERNAL_API_KEY=

# Avalanche rail of the MARKETPLACE (development simulation; all values below are the defaults and keep the rail off).
# To use the rail locally: start the gateway profile (docker compose --profile avalanche up), set AVALANCHE_GATEWAY_ENABLED=true and
# the same AVALANCHE_INTERNAL_API_KEY for both services. The network id must match the gateway deployment (avalanche-local for
# LOCAL_SIMULATION, avalanche-fuji for AVALANCHE_FUJI). Mainnet does not exist. MARKETPLACE_PRIMARY_RAIL (SOLANA or AVALANCHE) only
# chooses the default rail of NEW contracts.
MARKETPLACE_PRIMARY_RAIL=SOLANA
AVALANCHE_GATEWAY_ENABLED=false
AVALANCHE_GATEWAY_BASE_URL=http://avalanche-integration:9194
AVALANCHE_GATEWAY_NETWORK=avalanche-local
AVALANCHE_GATEWAY_SETTLEMENT_NOTIFICATIONS=false
# Non-custodial payout adapter (default off). Partner values: none, local-mock (LOCAL_SIMULATION only; the token is the mock USDC of the manifest).
AVALANCHE_PAYOUT_ENABLED=false
AVALANCHE_PAYOUT_PARTNER=none
AVALANCHE_PAYOUT_LOCAL_MOCK_TOKEN_ADDRESS=
AVALANCHE_PAYOUT_LOCAL_MOCK_DEPOSIT_ADDRESS=0x00000000000000000000000000000000000c0ffe
