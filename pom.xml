<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.FreelaX</groupId>
    <artifactId>FreelaX-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>FreelaX-parent</name>
    <description>Parent aggregator for payment-backend, marketplace-backend, misa-backend, solana-integration</description>

    <properties>
        <java.version>17</java.version>
        <nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>
        <springdoc.version>2.8.17</springdoc.version>
        <spring-dotenv.version>4.0.0</spring-dotenv.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <netty.version>4.1.137.Final</netty.version>
        <tomcat.version>10.1.61</tomcat.version>
        <bcprov-jdk15to18.version>1.85</bcprov-jdk15to18.version>
    </properties>

    <modules>
        <module>payment-backend</module>
        <module>marketplace-backend</module>
        <module>misa-backend</module>
        <module>solana-integration</module>
    </modules>

    <profiles>
        <!-- avalanche-integration targets Java 21 (web3j 6.1.0). It joins the reactor only on JDK 21+, so builds on
             JDK 17 (for example Dockerfile.maven) keep the original four-module reactor unchanged. -->
        <profile>
            <id>avalanche-integration</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <modules>
                <module>avalanche-integration</module>
            </modules>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk15to18</artifactId>
                <version>${bcprov-jdk15to18.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>me.paulschwarz</groupId>
                <artifactId>spring-dotenv</artifactId>
                <version>${spring-dotenv.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
