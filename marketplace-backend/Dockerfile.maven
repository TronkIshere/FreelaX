# syntax=docker/dockerfile:1.7

FROM maven:3.9-eclipse-temurin-17 AS builder
ARG MODULE
WORKDIR /build

COPY pom.xml .
COPY paypal-backend/pom.xml paypal-backend/pom.xml
COPY marketplace-backend/pom.xml marketplace-backend/pom.xml
COPY misa-backend/pom.xml misa-backend/pom.xml
RUN --mount=type=cache,target=/root/.m2 mvn -B -pl ${MODULE} -am dependency:go-offline

COPY ${MODULE}/src ${MODULE}/src
RUN --mount=type=cache,target=/root/.m2 mvn -B -pl ${MODULE} -am -DskipTests package \
    && java -Djarmode=layertools -jar ${MODULE}/target/*.jar extract --destination /build/extracted

FROM eclipse-temurin:17-jre-alpine AS runtime
WORKDIR /app
RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

COPY --from=builder /build/extracted/dependencies/ ./
COPY --from=builder /build/extracted/spring-boot-loader/ ./
COPY --from=builder /build/extracted/snapshot-dependencies/ ./
COPY --from=builder /build/extracted/application/ ./

ENTRYPOINT ["java", "org.springframework.boot.loader.launch.JarLauncher"]